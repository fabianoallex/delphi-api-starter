# Banco de dados Firebird
DB_PATH=C:\caminho\para\banco.fdb
DB_USER=SYSDBA
DB_PASSWORD=masterkey
FB_CLIENT_DIR=C:\Program Files\Firebird\Firebird_2_5\WOW64

# Para PostgreSQL, use DB_DIALECT=PostgreSQL e substitua as chaves acima por:
# DB_DIALECT=PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nome_do_banco
# DB_USER=postgres
# DB_PASSWORD=senha

# Pool de conexões (descomente para sobrescrever os padrões do DPR)
# POOL_INI_CONNECTIONS=1
# POOL_MAX_CONNECTIONS=5
# POOL_WAIT_MAX_ATTEMPS=10
# POOL_WAIT_MILLISECONDS=50
# POOL_IDLE_TIMEOUT_SECONDS=0
# POOL_IDLE_CHECK_INTERVAL_MS=30000

# Servidor
SERVER_PORT=9000
BASE_URL=http://localhost:9000

# Autenticação (descomente conforme o middleware ativo)
# API_KEY=troque-por-uma-chave-segura
# JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Mensageria RabbitMQ (descomente se o projeto consome/publica mensagens)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# RABBITMQ_QUEUE=nome_da_queue
